# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# Copy this file to Finance_Tracker/.env and fill in real values.
# On Vercel there is no .env file: add the same keys in
# Project Settings -> Environment Variables (Production AND Preview).
# ---------------------------------------------------------------------------

SECRET_KEY=generate-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.nks7sgj.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=finance_tracker_db

# ---------------------------------------------------------------------------
# PRODUCTION (use these values in the Vercel dashboard, not locally)
# ---------------------------------------------------------------------------
# DEBUG=false
# ALLOWED_HOSTS=.vercel.app
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app
# CORS_ALLOWED_ORIGINS=            (same origin via service rewrites, so empty)
